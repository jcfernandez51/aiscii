# Configuración común del proyecto. Copiar a .env en la raíz.
# URL base de la API compatible. Incluye /v1 si tu GoModel lo necesita.
# No incluyas /chat/completions: lo añade el backend.
AI_BASE_URL=https://api.example.com/v1
AI_API_KEY=key
AI_MODEL=model

# Clerk: instancia Development. Solo la clave publicable llega al navegador.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_reemplazar
CLERK_SECRET_KEY=sk_test_reemplazar
# Orígenes exactos separados por comas, sin barra final.
# Añade aquí el dominio real de Vercel cuando despliegues.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://127.0.0.1:5173
