{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "npm --prefix frontend ci && npm --prefix frontend run build",
  "functions": {
    "backend/main.py": {
      "maxDuration": 60,
      "excludeFiles": "{backend/tests/**,backend/.venv/**,frontend/node_modules/**}"
    }
  }
}
